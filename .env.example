# Nusxa oling: cp .env.example .env
DATABASE_URL="postgresql://ustoz:ustoz_dev_pw@localhost:5432/ustoz360?schema=public"
# Sessiya belgilarini xeshlash sirri: uzun tasodifiy qator (production'da majburiy)
AUTH_SECRET="dev-only-change-me-please-32chars-min"

# --- Ixtiyoriy: Google va Telegram orqali kirish (kalitlar bo'lmasa tugmalar ko'rinmaydi) ---
# Saytning to'liq manzili (Google redirect uchun). Vercel'da odatda shart emas, domen bo'lsa yozing.
# APP_URL="https://darsgoai.vercel.app"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""   # @ belgisiz, masalan: darsgoai_bot
# CRON_SECRET=               # botdagi kunlik eslatma uchun (Vercel Cron shu qiymat bilan chaqiradi). Uzun tasodifiy qator

# AI (Claude API). Kalitni faqat serverda saqlang, hech qachon repoga yozmang
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=30
# Bepul AI (OpenAI-mos shlyuz, masalan FreeLLMAPI)
# FREE_LLM_BASE_URL=
# FREE_LLM_API_KEY=
# FREE_LLM_MODEL=auto
# AI_FREE_DAILY_LIMIT=50
# Yandex orqali kirish (oauth.yandex.com)
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# --- BILIMXONA: fayl saqlash (Supabase Storage). Ikkalasi bo'lmasa fayl yuklash o'chirilgan (halol xabar) ---
# SUPABASE_URL="https://<loyiha>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=      # FAQAT serverda! Brauzerga va repoga hech qachon yozmang
# SUPABASE_STORAGE_BUCKET=library # shaxsiy (private) bucket, bo'lmasa o'zi yaratiladi

# --- To'lov provayderi (ixtiyoriy). Bo'lmasa admin "Bank o'tkazmasi" rejimini ishlatadi ---
# PAYMENT_WEBHOOK_SECRET=         # webhook HMAC-SHA256 imzosi uchun sir
# PAYMENT_CHECKOUT_URL="https://tolov.example/checkout?ref={reference}&sum={amount}"

# --- AI sozlamalari (qo'shimcha) ---
# AI_RETRY_MS=600                 # 5xx xatoda qayta urinishdan oldingi kutish (ms, eksponensial)
# AI_GLOBAL_DAILY_LIMIT=2000      # butun sayt uchun kunlik cheklov (Claude)
