generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  TEACHER
  COURSE_AUTHOR
  ORG_MANAGER
  METHODIST
  ADMIN
  SUPERADMIN
}

enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestMode {
  DIAGNOSTIC
  PRACTICE
  TIMED
  TOPIC
  MIXED
  ERRORS
  SIMULATION
  SITUATIONAL
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

// ---------- Accounts ----------
model User {
  id         String      @id @default(cuid())
  /// Kirish: email + parol. Telefon ixtiyoriy (keyin SMS/profil uchun).
  email        String?     @unique
  passwordHash String?
  /// Email tasdiqlangan vaqti (Google orqali kirganda to'ldiriladi). Parol bilan ro'yxatdan o'tishda bo'sh.
  emailVerifiedAt DateTime?
  yandexId     String?     @unique
  googleSub    String?     @unique
  telegramId   String?     @unique
  telegramUsername String?
  phone      String?     @unique
  name       String?
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  profile    Profile?
  roles      UserRole[]
  sessions   AuthSession[]
  testSessions TestSession[]
  mastery    TopicMastery[]
  errorCards ErrorCard[]
  auditLogs  AuditLog[]
  aiRequests AiRequest[]
  aiChats    AiChat[]
  examAttempts ExamAttempt[]
}

model Profile {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectFocus  String?
  grades        String?
  experience    Int?
  category      String?
  targetExam    String?
  examDate      DateTime?
  dailyMinutes  Int?
  region        String?
  district      String?
  /// Birinchi kirishdan keyin ism-familiya va yashash joyi to'ldirilgan vaqt. Bo'sh bo'lsa /royxat sahifasiga yo'naltiriladi.
  onboardedAt   DateTime?
}

model UserRole {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           RoleKey
  organizationId String?
  @@unique([userId, role, organizationId])
  @@index([userId])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

// ---------- Learning ----------
model Subject {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  topics Topic[]
}

model Topic {
  id        String     @id @default(cuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  slug      String     @unique
  name      String
  /// "Bu mavzuda nimalarni bilib olasiz?": 2-3 ta aniq o'quv maqsadi (admin kiritadi, bo'lmasa ko'rsatilmaydi).
  objectives String[]  @default([])
  questions Question[]
  mastery   TopicMastery[]
}

model Question {
  id         String         @id @default(cuid())
  topicId    String
  topic      Topic          @relation(fields: [topicId], references: [id])
  text       String
  explanation String
  difficulty Difficulty
  status     QuestionStatus @default(DRAFT)
  /// true bo'lsa: namunaviy savol, ekspert tekshirmagan. UI'da "Namunaviy savol" deb belgilanadi.
  isDemo     Boolean        @default(false)
  /// Eslab qolish uchun qisqa qoida ("Super kalit").
  superKey   String?
  /// MANUAL: admin kiritgan | AI: AI yaratgan (tasdiqlanmagan) | SAMPLE: namunaviy.
  source     String         @default("MANUAL")
  /// Manba nomi va bo'lim/sahifa (bo'lsa). Uydirilmaydi.
  sourceRef  String?
  /// Tekshiriladigan ko'nikma/tushuncha (masalan "formativ va summativ farqi"): xatolar testi va tahlil uchun.
  skill      String?
  /// CLASSIC: oddiy savol | SITUATIONAL: dars vaziyatiga asoslangan murakkab savol.
  kind       String         @default("CLASSIC")
  options    AnswerOption[]
  answers    UserAnswer[]
  errorCards ErrorCard[]
  createdAt  DateTime       @default(now())
  @@index([status, topicId])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int
  @@index([questionId])
}

model TestSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        TestMode
  status      SessionStatus @default(IN_PROGRESS)
  /// Sessiyaga kiritilgan savollar tartibi (JSON: questionId[]). Javob kaliti bu yerda saqlanmaydi.
  questionIds Json
  startedAt   DateTime      @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Int?
  total       Int?
  /// Mashq sozlamalari: tur, mavzular, qiyinlik, variantlar tartibi, ishoralar, AI savollar (javob kaliti emas).
  config      Json?
  answers     UserAnswer[]
  @@index([userId, startedAt])
}

model UserAnswer {
  id         String      @id @default(cuid())
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  optionId   String?
  isCorrect  Boolean
  hintUsed   Boolean     @default(false)
  answeredAt DateTime    @default(now())
  /// Vaziyatli testda "Qaroringizni asoslang" bo'yicha foydalanuvchining ixtiyoriy yozuvi.
  rationale  String?
  @@unique([sessionId, questionId])
}

/// Foydalanuvchi "Savolda xato bor" deb yuborgan xabarlar.
model QuestionReport {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  reason     String
  createdAt  DateTime @default(now())
  @@index([questionId])
}

model TopicMastery {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic      @relation(fields: [topicId], references: [id])
  correct    Int        @default(0)
  total      Int        @default(0)
  confidence Confidence @default(LOW)
  updatedAt  DateTime   @updatedAt
  @@unique([userId, topicId])
}

model ErrorCard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  mistakes   Int      @default(1)
  mastered   Boolean  @default(false)
  /// Oraliqli takrorlash: keyingi takrorlash vaqti va interval (kun)
  nextReviewAt DateTime
  intervalDays Int    @default(1)
  lastMistakeAt DateTime @default(now())
  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// ---------- System ----------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  @@index([action, createdAt])
}

/// AI so'rovlari jurnali: faqat metadata (matn saqlanmaydi, shaxsiy ma'lumot uchun). Kunlik limit va sarfni nazorat qilish uchun.
model AiRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  status       String
  createdAt    DateTime @default(now())
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// /ai sahifasidagi chatlar: foydalanuvchi o'zi ko'radi va o'chira oladi. Matn saqlanadi (AiRequest jurnalidan farqli).
model AiChat {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  model     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  @@index([userId, updatedAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
  @@index([chatId, createdAt])
}

/// Emailga yuboriladigan bir martalik kodlar: ro'yxatdan o'tishni tasdiqlash ("verify") va parolni tiklash ("reset"). Kodning o'zi emas, xeshi saqlanadi.
model EmailCode {
  id        String    @id @default(cuid())
  email     String
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([email, purpose, createdAt])
}

/// Telegram bot orqali saytga kirish: sayt havola yaratadi, foydalanuvchi botda Start bosadi, sayt kutib turib kiradi. Maxfiy kalit (pollHash) faqat brauzerda.
model TelegramLogin {
  id          String    @id @default(cuid())
  code        String    @unique
  pollHash    String
  /// Botda Start bosgan, lekin hali telefon raqamini tasdiqlamagan Telegram foydalanuvchisi.
  telegramId  String?
  userId      String?
  confirmedAt DateTime?
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  @@index([createdAt])
}

/// Telegram webhook yangilanishlarini takrorlamaslik uchun (Telegram javob kechiksa qayta yuboradi).
model TelegramUpdate {
  id        String   @id
  createdAt DateTime @default(now())
}

/// Imtihon simulyatori: imtihon shabloni (fan, turi, vaqt, savollar soni).
/// kind: TEST (variantli) | WRITTEN (yozma javob) | MIXED (aralash).
model Exam {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  subject     String
  kind        String
  durationMin Int
  /// Savollar bankidan nechtasi tushishi (bo'sh bo'lsa hammasi).
  pickCount   Int?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
}

/// type: CHOICE (options + correct: to'g'ri variant indeksi) | WRITTEN (accepted: qabul qilinadigan javoblar ro'yxati).
model ExamQuestion {
  id          String  @id @default(cuid())
  examId      String
  exam        Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  type        String
  text        String
  options     Json?
  correct     Int?
  accepted    Json?
  explanation String?
  @@index([examId])
}

/// Bitta urinish. order: savollar ketma-ketligi va variantlar aralashmasi (har urinishda yangicha), answers: {savolId: {c?: tanlangan variant (ko'rsatilgan tartibda), t?: yozma javob}}.
model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  submittedAt DateTime?
  order       Json
  answers     Json      @default("{}")
  score       Int?
  total       Int?
  /// Oynadan chiqish / to'liq ekrandan chiqish hodisalari soni.
  leftCount   Int       @default(0)
  @@index([userId, startedAt])
  @@index([examId])
}

/// Seminarlar: admin qo'shadi va tahrirlaydi, saytda /seminarlar sahifasida ko'rinadi.
model Seminar {
  id          String   @id @default(cuid())
  title       String
  description String?
  speaker     String?
  startsAt    DateTime
  durationMin Int?
  /// Joy (manzil) yoki onlayn bo'lsa platforma nomi.
  place       String?
  /// Onlayn qatnashish havolasi.
  link        String?
  capacity    Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([startsAt])
}