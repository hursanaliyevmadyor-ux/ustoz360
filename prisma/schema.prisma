generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  TEACHER
  COURSE_AUTHOR
  ORG_MANAGER
  METHODIST
  ADMIN
  SUPERADMIN
}

enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestMode {
  DIAGNOSTIC
  PRACTICE
  TIMED
  TOPIC
  MIXED
  ERRORS
  SIMULATION
  SITUATIONAL
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

// ---------- Accounts ----------
model User {
  id         String      @id @default(cuid())
  /// Kirish: email + parol. Telefon ixtiyoriy (keyin SMS/profil uchun).
  email        String?     @unique
  passwordHash String?
  /// Email tasdiqlangan vaqti (Google orqali kirganda to'ldiriladi). Parol bilan ro'yxatdan o'tishda bo'sh.
  emailVerifiedAt DateTime?
  yandexId     String?     @unique
  googleSub    String?     @unique
  telegramId   String?     @unique
  telegramUsername String?
  phone      String?     @unique
  name       String?
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  profile    Profile?
  roles      UserRole[]
  sessions   AuthSession[]
  testSessions TestSession[]
  mastery    TopicMastery[]
  errorCards ErrorCard[]
  auditLogs  AuditLog[]
  aiRequests AiRequest[]
  aiChats    AiChat[]
  knowledgeConsents KnowledgeConsent[]
  examAttempts ExamAttempt[]
  notifications Notification[]
  subscriptions Subscription[]
  payments   Payment[]
  teacherDocs TeacherDoc[]
  planItems  PlanItem[]
  checklist  ChecklistItem[]
  classrooms Classroom[]
  authoredCourses Course[] @relation("CourseAuthor")
  courseAccess CourseAccess[]
  libraryDocs LibraryDoc[]
  libraryFavorites LibraryFavorite[]
  botState   BotState?
}

/// Telegram botdagi holat: bot foydalanuvchidan keyingi matnni kutayotgan bo'lsa (masalan reja bandi nomi) va kunlik eslatma sozlamasi.
model BotState {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "idle" yoki kutilayotgan amal (masalan "plan.title", "ai").
  mode        String   @default("idle")
  data        Json?
  /// Kunlik eslatma (reja, seminar, takrorlash) yoqilganmi.
  remind      Boolean  @default(true)
  /// Oxirgi eslatma yuborilgan sana (Toshkent vaqti, YYYY-MM-DD): bir kunda bittadan ortiq yuborilmaydi.
  remindedOn  String?
  updatedAt   DateTime @updatedAt
}

/// Internet qidiruvi natijalarining vaqtinchalik keshi (Tavily kreditini tejash uchun). Kalit: so'rov va sozlamalarning xeshi. Foydalanuvchi ma'lumoti yo'q.
model WebSearchCache {
  key       String   @id
  query     String
  results   Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Profile {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectFocus  String?
  grades        String?
  experience    Int?
  category      String?
  targetExam    String?
  examDate      DateTime?
  dailyMinutes  Int?
  region        String?
  district      String?
  /// Birinchi kirishdan keyin ism-familiya va yashash joyi to'ldirilgan vaqt. Bo'sh bo'lsa /royxat sahifasiga yo'naltiriladi.
  onboardedAt   DateTime?
}

model UserRole {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           RoleKey
  organizationId String?
  @@unique([userId, role, organizationId])
  @@index([userId])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

// ---------- Learning ----------
model Subject {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  topics Topic[]
}

model Topic {
  id        String     @id @default(cuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  slug      String     @unique
  name      String
  /// "Bu mavzuda nimalarni bilib olasiz?": 2-3 ta aniq o'quv maqsadi (admin kiritadi, bo'lmasa ko'rsatilmaydi).
  objectives String[]  @default([])
  questions Question[]
  mastery   TopicMastery[]
}

model Question {
  id         String         @id @default(cuid())
  topicId    String
  topic      Topic          @relation(fields: [topicId], references: [id])
  text       String
  explanation String
  difficulty Difficulty
  status     QuestionStatus @default(DRAFT)
  /// true bo'lsa: namunaviy savol, ekspert tekshirmagan. UI'da "Namunaviy savol" deb belgilanadi.
  isDemo     Boolean        @default(false)
  /// Eslab qolish uchun qisqa qoida ("Super kalit").
  superKey   String?
  /// MANUAL: admin kiritgan | AI: AI yaratgan (tasdiqlanmagan) | SAMPLE: namunaviy.
  source     String         @default("MANUAL")
  /// Manba nomi va bo'lim/sahifa (bo'lsa). Uydirilmaydi.
  sourceRef  String?
  /// Tekshiriladigan ko'nikma/tushuncha (masalan "formativ va summativ farqi"): xatolar testi va tahlil uchun.
  skill      String?
  /// CLASSIC: oddiy savol | SITUATIONAL: dars vaziyatiga asoslangan murakkab savol.
  kind       String         @default("CLASSIC")
  options    AnswerOption[]
  answers    UserAnswer[]
  errorCards ErrorCard[]
  createdAt  DateTime       @default(now())
  @@index([status, topicId])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int
  @@index([questionId])
}

model TestSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        TestMode
  status      SessionStatus @default(IN_PROGRESS)
  /// Sessiyaga kiritilgan savollar tartibi (JSON: questionId[]). Javob kaliti bu yerda saqlanmaydi.
  questionIds Json
  startedAt   DateTime      @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Int?
  total       Int?
  /// Mashq sozlamalari: tur, mavzular, qiyinlik, variantlar tartibi, ishoralar, AI savollar (javob kaliti emas).
  config      Json?
  answers     UserAnswer[]
  @@index([userId, startedAt])
}

model UserAnswer {
  id         String      @id @default(cuid())
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  optionId   String?
  isCorrect  Boolean
  hintUsed   Boolean     @default(false)
  answeredAt DateTime    @default(now())
  /// Vaziyatli testda "Qaroringizni asoslang" bo'yicha foydalanuvchining ixtiyoriy yozuvi.
  rationale  String?
  @@unique([sessionId, questionId])
}

/// Foydalanuvchi "Savolda xato bor" deb yuborgan xabarlar.
model QuestionReport {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  reason     String
  createdAt  DateTime @default(now())
  @@index([questionId])
}

model TopicMastery {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic      @relation(fields: [topicId], references: [id])
  correct    Int        @default(0)
  total      Int        @default(0)
  confidence Confidence @default(LOW)
  updatedAt  DateTime   @updatedAt
  @@unique([userId, topicId])
}

model ErrorCard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  mistakes   Int      @default(1)
  mastered   Boolean  @default(false)
  /// Oraliqli takrorlash: keyingi takrorlash vaqti va interval (kun)
  nextReviewAt DateTime
  intervalDays Int    @default(1)
  lastMistakeAt DateTime @default(now())
  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// ---------- System ----------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  @@index([action, createdAt])
}

/// AI so'rovlari jurnali: faqat metadata (matn saqlanmaydi, shaxsiy ma'lumot uchun). Kunlik limit va sarfni nazorat qilish uchun.
model AiRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  status       String
  /// So'rov davomiyligi (ms), prompt versiyasi va taxminiy narx (mikro-dollar). Matn saqlanmaydi.
  latencyMs     Int?
  promptVersion String?
  costMicro     Int?
  /// Javobni qaysi xizmat berdi: "claude" yoki "free1".."free10" (FREE_LLM, FREE_LLM2_... slotlari). Provayder bo'yicha statistika uchun; eski qatorlarda bo'sh.
  provider      String?
  createdAt    DateTime @default(now())
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Umumiy bilimni yaxshilash uchun ixtiyoriy rozilik (Knowledge Hub, docs/KNOWLEDGE-HUB.md). Qator yo'q yoki revokedAt to'ldirilgan: rozilik YO'Q (standart).
/// Faqat rozilik bo'lsa tozalangan, umumlashtirilgan savol admin ko'rib chiqishiga nomzod bo'lishi mumkin; chat matni hech qachon ko'chirilmaydi.
model KnowledgeConsent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       String
  policyVersion String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  @@unique([userId, purpose])
}

/// /ai sahifasidagi chatlar: foydalanuvchi o'zi ko'radi va o'chira oladi. Matn saqlanadi (AiRequest jurnalidan farqli).
model AiChat {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  model     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  @@index([userId, updatedAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
  @@index([chatId, createdAt])
}

/// Emailga yuboriladigan bir martalik kodlar: ro'yxatdan o'tishni tasdiqlash ("verify") va parolni tiklash ("reset"). Kodning o'zi emas, xeshi saqlanadi.
model EmailCode {
  id        String    @id @default(cuid())
  email     String
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([email, purpose, createdAt])
}

/// Telegram bot orqali saytga kirish: sayt havola yaratadi, foydalanuvchi botda Start bosadi, sayt kutib turib kiradi. Maxfiy kalit (pollHash) faqat brauzerda.
model TelegramLogin {
  id          String    @id @default(cuid())
  code        String    @unique
  pollHash    String
  /// Botda Start bosgan, lekin hali telefon raqamini tasdiqlamagan Telegram foydalanuvchisi.
  telegramId  String?
  userId      String?
  confirmedAt DateTime?
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  @@index([createdAt])
}

/// Telegram webhook yangilanishlarini takrorlamaslik uchun (Telegram javob kechiksa qayta yuboradi).
model TelegramUpdate {
  id        String   @id
  createdAt DateTime @default(now())
}

/// Imtihon simulyatori: imtihon shabloni (fan, turi, vaqt, savollar soni).
/// kind: TEST (variantli) | WRITTEN (yozma javob) | MIXED (aralash).
model Exam {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  subject     String
  kind        String
  durationMin Int
  /// Savollar bankidan nechtasi tushishi (bo'sh bo'lsa hammasi).
  pickCount   Int?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
}

/// type: CHOICE (options + correct: to'g'ri variant indeksi) | WRITTEN (accepted: qabul qilinadigan javoblar ro'yxati).
model ExamQuestion {
  id          String  @id @default(cuid())
  examId      String
  exam        Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  type        String
  text        String
  options     Json?
  correct     Int?
  accepted    Json?
  explanation String?
  @@index([examId])
}

/// Bitta urinish. order: savollar ketma-ketligi va variantlar aralashmasi (har urinishda yangicha), answers: {savolId: {c?: tanlangan variant (ko'rsatilgan tartibda), t?: yozma javob}}.
model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  submittedAt DateTime?
  order       Json
  answers     Json      @default("{}")
  score       Int?
  total       Int?
  /// Oynadan chiqish / to'liq ekrandan chiqish hodisalari soni.
  leftCount   Int       @default(0)
  @@index([userId, startedAt])
  @@index([examId])
}

/// Seminarlar: admin qo'shadi va tahrirlaydi, saytda /seminarlar sahifasida ko'rinadi.
model Seminar {
  id          String   @id @default(cuid())
  title       String
  description String?
  speaker     String?
  startsAt    DateTime
  durationMin Int?
  /// Joy (manzil) yoki onlayn bo'lsa platforma nomi.
  place       String?
  /// Onlayn qatnashish havolasi.
  link        String?
  capacity    Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([startsAt])
}

// ---------- Platforma xizmatlari (sozlamalar, bildirishnoma, obuna, to'lov) ----------

/// Admin boshqaradigan sozlamalar (kalit-qiymat). MAXFIY KALITLAR bu yerda SAQLANMAYDI: ular faqat muhit o'zgaruvchilarida.
model SiteSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Masalan: seminar, reja, kurs, obuna, tizim.
  kind      String
  title     String
  text      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, createdAt])
}

/// Tarif kodda (src/lib/plans.ts); bu jadval foydalanuvchining qaysi tarifda ekanini saqlaydi.
/// status: ACTIVE | CANCELED | EXPIRED. source: MANUAL (admin bergan) | PAYMENT (tasdiqlangan to'lov).
model Subscription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey   String
  status    String    @default("ACTIVE")
  source    String    @default("PAYMENT")
  paymentId String?
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, status])
}

/// kind: COURSE | PLAN. status: PENDING | PAID | FAILED | CANCELED | REFUNDED.
/// Kirish/obuna faqat status PAID bo'lgandan keyin (server tasdig'i) beriladi. reference: foydalanuvchiga ko'rsatiladigan kod.
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  planKey     String?
  amount      Int
  currency    String    @default("UZS")
  provider    String
  providerRef String?
  reference   String    @unique
  status      String    @default("PENDING")
  meta        Json?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// To'lov provayderi xabarini takror ishlamaslik uchun (idempotent webhook).
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  createdAt DateTime @default(now())
  @@unique([provider, eventId])
}

// ---------- DARSYOR: o'qituvchi hujjatlari ----------

/// O'qituvchining saqlangan ishlari. kind: lesson_plan | visual | rubric | observation | taskset.
/// data: turiga qarab tuzilma (bo'limlar, diagramma, mezonlar, savollar). status: DRAFT | SAVED.
model TeacherDoc {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  subject   String?
  grade     String?
  data      Json
  status    String   @default("SAVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, kind, updatedAt])
}

// ---------- TOIFA NAVIGATOR ----------

/// Tayyorgarlik rejasi / kalendar bandi. source: MANUAL | AUTO (diagnostika va natijalarga ko'ra qoidalar bilan tuzilgan).
model PlanItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  title     String
  kind      String    @default("TASK")
  href      String?
  source    String    @default("MANUAL")
  doneAt    DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  @@index([userId, date])
}

model ChecklistItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  note      String?
  doneAt    DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  @@index([userId, position])
}

/// Rasmiy havola yoki sana (admin kiritadi). verified=false bo'lsa foydalanuvchiga "tekshirilmagan" deb ko'rsatiladi.
/// kind: LINK | DATE. exam: ATTESTATSIYA | MILLIY_SERTIFIKAT | bo'sh (umumiy).
model OfficialInfo {
  id         String    @id @default(cuid())
  kind       String
  exam       String?
  title      String
  url        String?
  date       DateTime?
  note       String?
  sourceName String?
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------- SINF ANALITIKA ----------

model Classroom {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  grade       String?
  createdAt   DateTime     @default(now())
  students    Student[]
  assessments Assessment[]
  @@index([userId])
}

/// O'quvchi faqat taxallus bilan yuritiladi (ism-familiya, telefon saqlanmaydi).
model Student {
  id        String            @id @default(cuid())
  classId   String
  classroom Classroom         @relation(fields: [classId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime          @default(now())
  scores    AssessmentScore[]
  @@unique([classId, alias])
}

/// kind: BEFORE (oldin) | AFTER (keyin) | CURRENT (joriy). Oldin/keyin taqqoslash bir xil topic bo'yicha.
model Assessment {
  id        String            @id @default(cuid())
  classId   String
  classroom Classroom         @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  topic     String
  kind      String            @default("CURRENT")
  maxScore  Int               @default(10)
  date      DateTime          @db.Date
  createdAt DateTime          @default(now())
  scores    AssessmentScore[]
  @@index([classId, date])
}

model AssessmentScore {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  @@unique([assessmentId, studentId])
}

// ---------- USTOZ MARKET ----------

/// status: DRAFT | REVIEW | APPROVED | REJECTED | ARCHIVED. Katalogda faqat APPROVED ko'rinadi.
model Course {
  id           String         @id @default(cuid())
  authorId     String
  author       User           @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  description  String         @default("")
  subject      String         @default("Umumiy")
  kind         String         @default("Videokurs")
  priceUzs     Int            @default(0)
  lessonCount  Int            @default(0)
  /// Kurs materiallariga havola (video, kanal, papka). Faqat kursga kirish olgan foydalanuvchiga ko'rsatiladi.
  accessUrl    String?
  status       String         @default("DRAFT")
  rejectReason String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  access       CourseAccess[]
  payments     Payment[]
  @@index([status, createdAt])
  @@index([authorId])
}

model CourseAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentId String?
  grantedAt DateTime @default(now())
  @@unique([userId, courseId])
}

// ---------- BILIMXONA ----------

/// Fayl Supabase Storage'da (storagePath), bu yerda faqat metadata.
/// visibility: PRIVATE | PUBLIC_PENDING (ommaviy qilish so'ralgan) | PUBLIC (admin tasdiqlagan).
/// status: UPLOADED | READY (matni indekslangan) | FAILED.
model LibraryDoc {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  fileName    String
  mime        String
  sizeBytes   Int
  storagePath String
  visibility  String            @default("PRIVATE")
  status      String            @default("UPLOADED")
  subject     String?
  tags        String[]          @default([])
  textChars   Int?
  createdAt   DateTime          @default(now())
  favorites   LibraryFavorite[]
  chunks      LibraryChunk[]
  @@index([ownerId, createdAt])
  @@index([visibility, status])
}

model LibraryFavorite {
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docId     String
  doc       LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  @@id([userId, docId])
}

/// RAG uchun tayyor: hujjat matni bo'laklari (hozircha faqat TXT). embedding keyinroq alohida qo'shiladi.
model LibraryChunk {
  id    String     @id @default(cuid())
  docId String
  doc   LibraryDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  idx   Int
  text  String
  @@unique([docId, idx])
}